# Vercel NO lee este archivo. El país se cambia en:
# lib/country-config.ts
#
# 1 = Brasil
# 2 = Perú
# 3 = Colombia
# 4 = Ecuador
# 5 = Paraguay
#
# Opcional en Vercel (Settings → Environment Variables):
# ACTIVE_COUNTRY=2

# URL de destino. Las IPs del país activo redirigen al instante.
REDIRECT_URL=https://www.exemplo.com/ofertas

# Opcional: fuerza un país de IP para pruebas locales.
# GEO_COUNTRY_OVERRIDE=BR
